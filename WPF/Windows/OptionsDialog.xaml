<local:ThemedWindow
    xmlns:local="clr-namespace:ZenTimings"
    x:Class="ZenTimings.Windows.OptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theming="clr-namespace:ZenTimings.Theming"
    xmlns:controls="clr-namespace:ZenTimings.Controls"
    mc:Ignorable="d"
    x:Name="OptionsWindow"
    Title="{DynamicResource Loc_Options_Title}"
    Height="560"
    Width="702"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    Icon="/ZenTimings;component/Resources/new-icon/16.png"
    SizeToContent="WidthAndHeight"
    ShowInTaskbar="False"
    BorderThickness="1"
    UseLayoutRounding="True"
    Style="{DynamicResource WindowStyles}"
    Closing="OptionsWindow_Closing">

    <local:ThemedWindow.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Padding" Value="4 3" />
        </Style>
        <Style x:Key="SectionIcon" TargetType="controls:AppIcon">
            <Setter Property="IconWidth" Value="12" />
            <Setter Property="IconHeight" Value="12" />
            <Setter Property="Fill" Value="{DynamicResource TextColor}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 3 4 3" />
        </Style>
        <Style x:Key="SectionHeaderPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
        </Style>
        <Style x:Key="SectionPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical" />
            <Setter Property="Margin" Value="6 2" />
        </Style>
        <Style x:Key="SectionGrid" TargetType="Grid">
            <Setter Property="Margin" Value="20 4 8 4" />
        </Style>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 2 5 2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Static theming:ThemeStyles.ToggleSwitch}}">
            <Setter Property="Margin" Value="0 2 5 2" />
        </Style>
        <Style x:Key="SettingCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="5 4 0 4" />
            <Setter Property="Width" Value="151" />
        </Style>
    </local:ThemedWindow.Resources>

    <StackPanel x:Name="OptionWindowContent" Margin="4 0">
        <Popup
            x:Name="OptionsPopup"
            Panel.ZIndex="100"
            PlacementTarget="{Binding ElementName=OptionWindowContent}"
            VerticalAlignment="Center"
            Placement="Relative"
            HorizontalAlignment="Center"
            VerticalOffset="0"
            AllowsTransparency="True"
            Opacity="0.8"
            PopupAnimation="Fade"
            ClipToBounds="True"
            StaysOpen="False"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            MouseDown="OptionsPopup_MouseDown">
            <TextBlock
                Name="OptionsPopupText"
                Background="{DynamicResource SuccessBackground}"
                Padding="10" Opacity="0.95">
                Settings Saved.
            </TextBlock>
        </Popup>

        <Grid Margin="0 0 0 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- General -->
        <StackPanel Grid.Column="0" Grid.Row="0" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconGeneral" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Common_General}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAdvancedMode"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_AdvancedMode}"
                    Click="CheckBoxAdvancedMode_Click" />

                <ToggleButton
                    x:Name="checkBoxAutoRefresh"
                    Grid.Column="0"
                    Grid.Row="1"
                    Content="{DynamicResource Loc_Options_AutoRefresh}"
                    Style="{StaticResource SettingToggle}"
                    Click="CheckBoxAutoRefresh_Click" />

                <controls:NumericTextBox
                    x:Name="numericUpDownRefreshInterval"
                    Minimum="20"
                    Increment="100"
                    FallbackValue="2000"
                    AllowEmpty="False"
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="msText"
                    Grid.Column="2"
                    Grid.Row="1"
                    Content="{DynamicResource Loc_Common_Milliseconds}"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxCheckUpdate"
                    Grid.Column="0"
                    Grid.Row="2"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_CheckUpdates}" />

                <TextBlock
                    x:Name="labelReleaseChannel"
                    Grid.Column="0"
                    Grid.Row="3"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_ReleaseChannel}"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxCheckUpdate}" />

                <ComboBox
                    x:Name="comboBoxReleaseChannel"
                    Grid.Column="1"
                    Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource SettingCombo}"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxCheckUpdate}">
                    <ComboBoxItem Content="{DynamicResource Loc_Options_Stable}" ToolTip="{DynamicResource Loc_Options_StableTooltip}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_Beta}" ToolTip="{DynamicResource Loc_Options_BetaTooltip}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_Any}" ToolTip="{DynamicResource Loc_Options_AnyTooltip}" />
                </ComboBox>

                <ToggleButton
                    x:Name="checkBoxSingleInstance"
                    Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_SingleInstance}" />

                <TextBlock
                    x:Name="labelLanguage"
                    Grid.Column="0"
                    Grid.Row="5"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_Language}" />

                <!-- 条目由代码按受支持语言填充，切换后界面立即刷新 -->
                <ComboBox
                    x:Name="comboBoxLanguage"
                    Grid.Column="1"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource SettingCombo}"
                    ToolTip="{DynamicResource Loc_Options_LanguageTooltip}"
                    SelectionChanged="ComboBoxLanguage_SelectionChanged" />
            </Grid>
        </StackPanel>

        <!-- Appearance -->
        <StackPanel Grid.Column="0" Grid.Row="1" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconAppearance" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Options_Appearance}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_Theme}" />
                <ComboBox
                    x:Name="comboBoxTheme"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}"
                    SelectionChanged="ComboBoxTheme_SelectionChanged">
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeLight}" Tag="Light" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeDark}" Tag="Dark" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeDarkMint}" Tag="DarkMint" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeDarkMintGradient}" Tag="DarkMintGradient" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeAsusRog}" Tag="AsusRog" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeDracula}" Tag="Dracula" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeRetroWave}" Tag="RetroWave" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeBurntOrange}" Tag="BurntOrange" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ThemeBlack}" Tag="Black" />
                </ComboBox>

                <TextBlock
                    x:Name="labelCornerRadius"
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_CornerRadius}" />
                <ComboBox
                    x:Name="comboBoxCornerRadius"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="1"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="{DynamicResource Loc_Common_Auto}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_NoRadius}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_DefaultRadius}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_SmallRadius}" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Sensors -->
        <StackPanel Grid.Column="1" Grid.Row="0" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconTemperature" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Options_SensorSources}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    x:Name="labelImpedanceSource"
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_ImpedanceTable}" />
                <ComboBox
                    x:Name="comboBoxImpedanceSource"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="{DynamicResource Loc_Options_Legacy}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_Extended}" />
                </ComboBox>

                <TextBlock
                    x:Name="labelVsocSource"
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="VSOC" />
                <ComboBox
                    x:Name="comboBoxVsocSensorSource"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="1"
                    Style="{StaticResource SettingCombo}" />

                <TextBlock
                    x:Name="labelVddioSource"
                    Grid.Column="0"
                    Grid.Row="2"
                    Style="{StaticResource SettingLabel}"
                    Text="VDDIO" />
                <ComboBox
                    x:Name="comboBoxVddioSensorSource"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="2"
                    Style="{StaticResource SettingCombo}" />

                <TextBlock
                    x:Name="labelVmiscSource"
                    Grid.Column="0"
                    Grid.Row="3"
                    Style="{StaticResource SettingLabel}"
                    Text="VDD MISC" />
                <ComboBox
                    x:Name="comboBoxVmiscSensorSource"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    Grid.Row="3"
                    Style="{StaticResource SettingCombo}" />
            </Grid>
        </StackPanel>

        <!-- Startup & Window -->
        <StackPanel Grid.Column="0" Grid.Row="2" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconStartup" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Options_StartupWindow}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAutostart"
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_Autostart}"
                    Click="CheckBoxAutostart_Click" />

                <controls:NumericTextBox
                    x:Name="numericUpDownAutostartDelay"
                    FallbackValue="12"
                    AllowEmpty="False"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="5 0 5 0" />

                <Label
                    x:Name="secText"
                    Grid.Column="2"
                    Grid.Row="0"
                    Content="{DynamicResource Loc_Common_SecondsShort}"
                    VerticalAlignment="Center"
                    Padding="5 0" FontWeight="Normal" />

                <ToggleButton
                    x:Name="checkBoxStartMinimized"
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_StartMinimized}" />

                <ToggleButton
                    x:Name="checkBoxMinimizeToTray"
                    Content="{DynamicResource Loc_Options_MinimizeToTray}"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}" />

                <ToggleButton
                    x:Name="checkBoxSavePosition"
                    Grid.Column="0"
                    Grid.Row="3"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_SavePosition}" />

                <ToggleButton
                    x:Name="checkBoxWindowSnapping"
                    Grid.Column="0"
                    Grid.Row="4"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_SnapWindows}" />
            </Grid>
        </StackPanel>

        <!-- Driver -->
        <StackPanel Grid.Column="1" Grid.Row="2" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconDriver" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Options_Driver}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />

            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <ToggleButton
                    x:Name="checkBoxAutoUninstallDriver"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Style="{StaticResource SettingToggle}"
                    Content="{DynamicResource Loc_Options_UninstallInpout}" />

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_UninstallNotifications}" />

                <ComboBox
                    x:Name="comboBoxDriverNotification"
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource SettingCombo}"
                    IsEnabled="{Binding IsChecked, ElementName=checkBoxAutoUninstallDriver}">
                    <ComboBoxItem Content="{DynamicResource Loc_Common_None}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ErrorsOnly}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Main_All}" />
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- Screenshot -->
        <StackPanel Grid.Column="1" Grid.Row="1" Style="{StaticResource SectionPanel}">
            <StackPanel Style="{StaticResource SectionHeaderPanel}">
                <controls:AppIcon Kind="IconScreenshot" Style="{StaticResource SectionIcon}" />
                <TextBlock Text="{DynamicResource Loc_Options_Screenshot}" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <Border Style="{DynamicResource Separator}" />
            <Grid Style="{StaticResource SectionGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="78" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_Mode}" />
                <ComboBox
                    x:Name="comboBoxScreenshot"
                    Grid.ColumnSpan="2"
                    Grid.Column="1"
                    Grid.Row="0"
                    Style="{StaticResource SettingCombo}">
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ScreenshotAppWindow}" />
                    <ComboBoxItem Content="{DynamicResource Loc_Options_ScreenshotFullDesktop}" />
                </ComboBox>

                <TextBlock
                    x:Name="screenshotPath"
                    Grid.Column="0"
                    Grid.Row="1"
                    Style="{StaticResource SettingLabel}"
                    Text="{DynamicResource Loc_Options_Location}" />

                    <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2">
                        <TextBox
                            x:Name="textBoxScreenshotPath"
                            Margin="5 4 0 0"
                            Width="120"
                            IsReadOnly="True"
                            VerticalAlignment="Top" />

                        <Button
                            x:Name="buttonBrowseScreenshotPath"
                            Margin="5 4 0 0"
                            Width="26"
                            Height="24"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ToolTip="{DynamicResource Loc_Common_BrowseShort}"
                            Click="ButtonBrowseScreenshotPath_Click">
                            <controls:AppIcon Kind="IconFolder" IconWidth="13" IconHeight="13" Fill="{DynamicResource TextColor}" />
                        </Button>
                    </StackPanel>
                </Grid>
        </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="buttonSettingsRestart"
                Grid.Column="1"
                Content="{DynamicResource Loc_Common_Restart}"
                Visibility="Hidden"
                Margin="6 6 0 6"
                Width="70"
                Click="ButtonSettingsRestart_Click" />

            <Button
                x:Name="buttonSettingsReset"
                Grid.Column="0"
                Content="{DynamicResource Loc_Common_Reset}"
                HorizontalAlignment="Left"
                Margin="6 6 0 6"
                Width="70"
                Click="ButtonSettingsReset_Click" />

            <Button
                x:Name="buttonSettingsApply"
                Grid.Column="3"
                Content="{DynamicResource Loc_Common_Apply}"
                Margin="6 6 0 6"
                Style="{DynamicResource {x:Static theming:ThemeStyles.AccentButton}}"
                Width="70"
                Click="ButtonSettingsApply_Click" />

            <Button
                x:Name="buttonSettingsCancel"
                Grid.Column="4"
                Content="{DynamicResource Loc_Common_Close}"
                IsCancel="True"
                Width="70"
                Margin="6"
                Click="ButtonSettingsCancel_Click" />
        </Grid>
    </StackPanel>
</local:ThemedWindow>
